# Expo web client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WANPANE_ENV=
EXPO_PUBLIC_SUPABASE_STAGING_PROJECT_REF=
EXPO_PUBLIC_SUPABASE_PRODUCTION_PROJECT_REF=
EXPO_PUBLIC_RULE_REVIEW_RULE_SET_ID=
EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=

# Server/CLI only. Never use EXPO_PUBLIC_ for these values.
WANPANE_ENV=
SUPABASE_STAGING_URL=
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_STAGING_ANON_KEY=
RULE_REVIEW_STAGING_ACCESS_TOKEN=
RULE_REVIEW_STAGING_RULE_SET_ID=
RULE_REVIEW_STAGING_ALLOW_WRITE=false
SUPABASE_STAGING_SERVICE_ROLE_KEY=

