{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-web-build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/event-api/listings.ts": {
      "includeFiles": "{data/events/*.json,features/discovery/server/ApplyHomeApi.ts,features/discovery/server/package.json,features/eventKiosk/frozen/domain/rules.ts,features/eventKiosk/live/**,features/eventKiosk/media/*.ts,features/eventKiosk/media/package.json}"
    },
    "api/event-api/result-sessions/**/*.ts": {
      "includeFiles": "{features/eventKiosk/server/**,features/productV3/admin/stagingTarget.ts,scripts/event-result-session-store.mjs}"
    },
    "api/event-api/chat.ts": {
      "includeFiles": "{features/eventKiosk/{server/eventChat.ts,chat/{contract.ts,privacy.ts,package.json},samdoDual/{rag.ts,types.ts,package.json}},features/productV3/{admin/staging*.ts,analytics/server.ts},data/event/samdo-dual-v2-rag.json}"
    },
    "api/admin-api/product-v3.ts": {
      "includeFiles": "{features/{adminConsole/**,assessmentRuleReview/**,productV3/**,noticePlatform/**,profile/**,applicationAssessment/**,eventKiosk/**},data/{assessment-rules/{*v1.8,lh-jeju-ildo-samdo-happy-20260918*}.json,event/samdo-dual-v2-rag.json}}"
    },
    "api/event-api/assessments.ts": {
      "includeFiles": "{features/{productV3/{admin/{assessmentEvents.ts,stagingTarget.ts},analytics/**},noticePlatform/**,eventKiosk/{noticePlatform/**,samdo/**,samdoDual/**,samdoResult/**},applicationAssessment/**,profile/**},data/{assessment-rules/*v1.8.json,event/samdo-dual-v2-rag.json}}"
    },
    "api/event-api/analytics.ts": {
      "includeFiles": "{features/{productV3/{analytics/**,admin/stagingTarget.ts},noticePlatform/**,eventKiosk/{noticePlatform/**,samdo/**,samdoDual/**,samdoResult/**},applicationAssessment/**,profile/**},data/{assessment-rules/*v1.8.json,event/samdo-dual-v2-rag.json}}"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin-api/product-v3",
      "destination": "/api/admin-api/product-v3"
    },
    {
      "source": "/event-api/listings",
      "destination": "/api/event-api/listings"
    },
    {
      "source": "/event-api/result-sessions",
      "destination": "/api/event-api/result-sessions"
    },
    {
      "source": "/event-api/result-sessions/:token",
      "destination": "/api/event-api/result-sessions/:token"
    },
    {
      "source": "/event-api/chat",
      "destination": "/api/event-api/chat"
    },
    {
      "source": "/event-api/assessments",
      "destination": "/api/event-api/assessments"
    },
    {
      "source": "/event-api/analytics",
      "destination": "/api/event-api/analytics"
    },
    {
      "source": "/discovery/:id",
      "destination": "/discovery/[id]"
    },
    {
      "source": "/admin/scoring/:id",
      "destination": "/admin/scoring/[id]"
    },
    {
      "source": "/admin/announcements/:id",
      "destination": "/admin/announcements/[id]"
    }
  ]
}
